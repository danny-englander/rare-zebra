---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import ZebraLogo from "../../components/ZebraLogo.astro";
import { diseases, dataVersion } from "../../data/diseases";

export function getStaticPaths() {
  return diseases.map((disease) => ({
    params: { slug: disease.slug },
    props: { disease },
  }));
}

const { disease } = Astro.props;
---

<Layout
  title={`${disease.name} — Rare Zebra`}
  description={disease.note}
>
  <main class='mx-auto max-w-3xl px-4 py-10 sm:px-6 print:max-w-none print:p-0'>
    <div
      data-pagefind-ignore
      class='print:hidden flex items-center justify-between gap-4'
    >
      <a href='/' class='text-base inline-link'>&larr; Back to search</a>
      <button
        type='button'
        id='print-trigger'
        class='btn btn-outline field-accent btn-sm gap-1.5 font-normal'
      >
        <Icon name='material-symbols:print-outline' class='h-5 w-5' />
        Print / Save as PDF
      </button>
    </div>

    <div class='hidden print:mb-8 print:flex print:items-center print:gap-2'>
      <ZebraLogo class='h-10 w-6 text-black' />
      <span class='font-display text-2xl font-medium'>Rare Zebra</span>
    </div>

    <article class='mt-6 print:mt-0' data-pagefind-body>
      <p
        class='text-base text-muted'
        data-pagefind-meta={`orphaCode:${disease.orphaCode}`}
      >
        {disease.orphaCode}
      </p>
      <h1
        class='font-display mt-1 text-4xl font-medium tracking-tight sm:text-5xl print:text-3xl'
      >
        {disease.name}
      </h1>
      {
        disease.synonyms.length > 0 && (
          <p class='mt-2 text-base-content'>
            Also called {disease.synonyms.join(", ")}
          </p>
        )
      }

      <dl
        class='mt-8 grid grid-cols-1 gap-x-8 gap-y-4 border-y border-base-300 py-6 sm:grid-cols-2 print:mt-4 print:border-0 print:py-0'
      >
        <div>
          <dt class='text-sm text-muted'>Body system</dt>
          <dd
            class='mt-1'
            data-pagefind-filter={`System:${disease.system}`}
            data-pagefind-meta={`system:${disease.system}`}
          >
            {disease.system}
          </dd>
        </div>
        <div>
          <dt class='text-sm text-muted'>Inheritance pattern</dt>
          <dd
            class='mt-1'
            data-pagefind-meta={`inheritance:${disease.inheritance.join(", ")}`}
          >
            {
              disease.inheritance.map((pattern, i) => (
                <span data-pagefind-filter={`Inheritance:${pattern}`}>
                  {pattern}
                  {i < disease.inheritance.length - 1 ? ", " : ""}
                </span>
              ))
            }
          </dd>
        </div>
        <div>
          <dt class='text-sm text-muted'>Typical age of onset</dt>
          <dd
            class='mt-1'
            data-pagefind-meta={`ageOfOnset:${disease.ageOfOnset.join(", ")}`}
          >
            {
              disease.ageOfOnset.map((onset, i) => (
                <span data-pagefind-filter={`AgeOfOnset:${onset}`}>
                  {onset}
                  {i < disease.ageOfOnset.length - 1 ? ", " : ""}
                </span>
              ))
            }
          </dd>
        </div>
        <div>
          <dt class='text-sm text-muted'>Estimated prevalence</dt>
          <dd
            class='mt-1'
            data-pagefind-meta={`prevalence:${disease.prevalence}`}
          >
            {disease.prevalence}
          </dd>
        </div>
        <div>
          <dt class='text-sm text-muted'>Rarity class</dt>
          <dd
            class='mt-1'
            data-pagefind-filter={`Rarity:${disease.rarity}`}
            data-pagefind-meta={`rarity:${disease.rarity}`}
          >
            {disease.rarity}
          </dd>
        </div>
      </dl>

      <p
        class='mt-8 leading-relaxed'
        data-pagefind-meta={`note:${disease.note}`}
      >
        {disease.note}
      </p>

      <div class='mt-8 print:mt-6'>
        <h2 class='text-base font-medium text-base-content'>Common signs</h2>
        <ul class='mt-3 flex flex-wrap gap-2'>
          {
            disease.symptoms.map((symptom) => (
              <li class='rounded-field border border-base-300 px-3 py-1 text-base'>
                {symptom}
              </li>
            ))
          }
        </ul>
      </div>

      <p class='hidden print:block print:mt-10 print:text-sm print:text-base-content/70'>
        Source: Orphanet (Orphadata), {disease.orphaCode}. Data release {dataVersion}. www.orphadata.com — CC BY 4.0.
      </p>
    </article>
  </main>
</Layout>

<script is:inline>
  (function () {
    var trigger = document.getElementById("print-trigger");
    if (!trigger) return;
    trigger.addEventListener("click", function () {
      window.print();
    });
  })();
</script>
