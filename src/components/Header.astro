---
import ZebraLogo from "./ZebraLogo.astro";
import MainNav from "./MainNav.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header data-pagefind-ignore class='border-b border-base-300 print:hidden'>
  <div class='mx-auto max-w-5xl px-4 pt-4 sm:px-6'>
    <div class='flex items-center justify-between gap-4'>
      <a
        href='/'
        class='flex items-center gap-2 font-display text-2xl font-medium tracking-tight text-base-content hover:text-secondary focus-visible:text-secondary'
      >
        <ZebraLogo class='h-[46px] w-[29px] md:h-[74px] md:w-[47px]' />
        Rare Zebra
      </a>
      <div class='flex items-center gap-1'>
        <ThemeToggle />
        <MainNav />
      </div>
    </div>
    <p class='mt-1 pb-3 text-sm text-muted'>
      Rare disease search prototype built on Orphanet data
    </p>
    <div class='dot-rule w-24 mb-3' aria-hidden='true'></div>
  </div>
</header>
